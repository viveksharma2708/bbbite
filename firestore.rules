rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny (Must be first)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() {
      let adminEmails = ['vivek5656sharma@gmail.com', 'vivekbaba11@gmail.com'];
      return isSignedIn() && (
        request.auth.token.email in adminEmails ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // --- ENTITY VALIDATION ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['user', 'admin'];
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'isAvailable', 'updatedAt']) &&
             data.name is string && data.name.size() < 100 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.isAvailable is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status', 'deliveryAddress', 'paymentMethod', 'paymentStatus', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.totalAmount is number &&
             data.status in ['placed', 'preparing', 'out_for_delivery', 'delivered', 'cancelled'] &&
             data.deliveryAddress is string && data.deliveryAddress.size() < 500 &&
             data.paymentMethod in ['online', 'cod'] &&
             data.paymentStatus in ['pending', 'paid', 'failed'];
    }

    // --- COLLECTIONS ---

    // 1. Products: Publicly readable catalog
    match /products/{productId} {
      allow get, list: if true;
      allow write: if isAdmin() && (request.method == 'delete' || isValidProduct(incoming()));
    }
    
    // 2. Settings: Publicly readable configuration
    match /settings/{settingId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    // 3. Users: Private profile access
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId) && isValidUser(incoming());
      allow update: if (isSignedIn() && (request.auth.uid == userId) && incoming().role == existing().role) || isAdmin();
    }
    
    // 4. Orders: User's own orders or admin access
    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid && 
        incoming().status == existing().status &&
        incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'deliveryAddress'])
      );
      allow delete: if isAdmin();
    }

    // 5. Test/Health
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

